# Полное имя образа без тега.
GHCR_IMAGE=ghcr.io/vryzhkov/calendarthirteen

# latest обновляется при каждом push в main. Для предсказуемого
# развёртывания укажите версию, например v1.0.0.
IMAGE_TAG=latest

# 127.0.0.1 безопасен для работы за обратным прокси.
# Для прямого доступа по IP используйте 0.0.0.0.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
